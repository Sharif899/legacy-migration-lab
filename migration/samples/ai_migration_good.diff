diff --git a/tests/test_migration.py b/tests/test_migration.py
--- a/tests/test_migration.py
+++ b/tests/test_migration.py
@@ -0,0 +1,12 @@
+"""Tests for the migrated ledger."""
+
+from decimal import Decimal
+
+from modern.ledger import Ledger
+
+
+def test_deposit_and_balance() -> None:
+    ledger = Ledger()
+    ledger.create_account("ada", "s3cret")
+    ledger.deposit("ada", Decimal("100.00"))
+    assert ledger.balance("ada") == Decimal("100.00")
